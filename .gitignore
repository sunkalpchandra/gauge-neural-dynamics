# Environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# LaTeX build products. paper/main.pdf itself IS tracked.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/b.log
paper/build*.log

# build_paper.sh copies figures/ here; the originals are tracked, these are not.
paper/figures/

# Everything else under results/ IS tracked, including the .npz artefacts: they
# are what lets a new contributor regenerate every figure without repeating the
# multi-hour sweep. Only the run logs are excluded, being regenerable.
results/logs/*.log

# Smoke runs (run_all.py --quick) write here so that they cannot overwrite the
# results and figures the paper is built from.
results/quick/
figures/quick/
